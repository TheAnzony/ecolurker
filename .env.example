# --- Credenciales de Discord (Developer Portal > Bot) ---
DISCORD_TOKEN=
CLIENT_ID=
# Opcional: si se define, los slash commands se registran solo en este servidor
# (instantaneo, ideal para desarrollo). Si se deja vacio, se registran de forma
# global (tarda hasta 1 hora en propagarse).
GUILD_ID=

# --- Base de datos ---
# Ruta dentro del contenedor. Debe coincidir con el volumen montado en docker-compose.yml
DB_PATH=./data/bot.db

# --- Politica de inactividad ---
# Dias sin actividad de voz tras los cuales un miembro se considera inactivo.
# Es solo el valor POR DEFECTO: cada servidor puede ajustarlo con /configurar
# y su valor queda guardado en la base de datos.
# Quien no tenga ningun registro de voz se marca de inmediato, salvo que lleve
# menos de estos mismos dias en el servidor (periodo de gracia).
DEFAULT_INACTIVE_DAYS=14

# Cada cuantas horas se re-sincroniza automaticamente el rol Inactivo.
# Con 1 hora, el rol se aplica como mucho 1h despues de cumplirse el plazo.
SYNC_INTERVAL_HOURS=1

# --- Rol Inactivo ---
# ID del rol "Inactivo". Si se deja vacio, el bot busca un rol llamado
# "Inactivo" y, si no existe, lo crea automaticamente y recuerda su ID.
INACTIVE_ROLE_ID=

# --- Seguridad ---
# Interruptor de expulsiones. Con "false" (por defecto), la accion "expulsar"
# de /moderar-inactivos se rechaza aunque se confirme. El bot NUNCA expulsa
# de forma automatica: solo marca y desmarca el rol Inactivo.
ALLOW_KICK=false

# Mensaje enviado por MD cuando la accion es "aviso"
INACTIVE_WARNING_MESSAGE=Hola, no se ha detectado actividad tuya en los canales de voz del servidor durante un tiempo prolongado. Si sigues interesado en formar parte de la comunidad, conectate a voz para evitar ser marcado como inactivo.
